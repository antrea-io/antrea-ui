{
  "name": "@antrea/ui-plugin-sdk",
  "version": "0.1.0",
  "description": "Registration API for Antrea UI plugins that extend an existing page (e.g. flow table columns, the service map's edge details card), modeled on Headlamp's plugin registry",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn workspace @antrea/ui-components build && yarn build"
  },
  "peerDependencies": {
    "@antrea/ui-components": "workspace:*"
  },
  "devDependencies": {
    "@antrea/ui-components": "workspace:*",
    "typescript": "^7.0.0"
  }
}
